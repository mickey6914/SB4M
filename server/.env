# Express Art Vibe Pin-Post Studio — server settings
#
# HOW TO USE THIS FILE
#   1. Make a copy of it in this same folder, named exactly:  .env
#   2. Paste your keys after the "=" signs (no quotes, no spaces around the =)
#   3. Restart the server  (stop it with Ctrl+C, then: npm run dev:server)
#
# The server reads .env automatically on startup. If a key isn't taking
# effect, the usual causes are: the file is named .env.txt instead of .env,
# it isn't in the server/ folder, or the server wasn't restarted.
#
# Your .env file is git-ignored on purpose — it never gets committed or
# uploaded to GitHub. This .env.example is the safe, key-free template.
#
# NOTHING HERE IS REQUIRED. The app runs without any of it; each key just
# switches one feature from "honest message" to "working". Add them one at a
# time, in whatever order suits you.


# ─────────────────────────────────────────────────────────────────────
# 1. ANTHROPIC — AI copywriting (titles, descriptions, keywords)
# ─────────────────────────────────────────────────────────────────────
# Get a key: console.anthropic.com → Settings → API Keys → Create Key
#            (needs a payment method; $5 of credit goes a very long way)
# Costs:     roughly $0.25 per 30-pin run
# Without:   the "Rewrite with AI" button explains the key is missing;
#            you can still write copy by hand
#
ANTHROPIC_API_KEY=

# Optional. Leave blank to use the default (claude-opus-5).
ANTHROPIC_MODEL=


# ─────────────────────────────────────────────────────────────────────
# 2. IMAGE PROVIDER — scene backgrounds for the pin mockups
# ─────────────────────────────────────────────────────────────────────
# Pick ONE provider and fill in only its key.
#
# Your product photo is NEVER sent to these services — they only draw an
# empty background, and your real photo is composited on top afterwards.
#
# Set to:  google      → Google Imagen / Gemini  (~$0.02 per image)
#          openai      → OpenAI GPT Image        (~$0.005 per image)
#          procedural  → built-in plain backdrop (free, no key needed)
#
# Either way it's about 3 background images per run, so pennies per run.
# Leave blank and the app picks whichever key you filled in below.
#
SCENE_PROVIDER=

# --- If you chose google ---
# Get a key: aistudio.google.com → "Get API key"
GEMINI_API_KEY=

# Optional. Leave blank for the default (imagen-4.0-fast-generate-001,
# the cheap fast one). To use "Nano Banana Pro" instead, put:
#   gemini-3-pro-image-preview
GOOGLE_IMAGE_MODEL=

# --- If you chose openai ---
# Get a key: platform.openai.com → API keys
# NOTE: this is billed separately from a ChatGPT Plus subscription, even
#       though you sign in with the same account.
OPENAI_API_KEY=

# Optional. Leave blank for the default (gpt-image-1-mini).
OPENAI_IMAGE_MODEL=


# ─────────────────────────────────────────────────────────────────────
# 3. CONTENT360 — pushing the finished batch out for publishing
# ─────────────────────────────────────────────────────────────────────
# Get a key: your Content360 workspace settings page
# Costs:     nothing beyond your existing Content360 plan
# Without:   "Push to Content360" explains the key is missing
#
# NOTE: your plan's AI content generation is not reachable from this API —
# it only works inside Content360's own composer. AI copywriting in this
# app is the ANTHROPIC_API_KEY above. See DECISIONS.md section 8.
#
CONTENT360_API_KEY=BEv633qLyWY6hI640dnqwKezsq7NGml250AraAyg5ad33b72

# Optional. Leave blank to use the workspace id from the design spec
# (34b00c5d-265d-4c55-92b7-ebbc57669d39). It is the uuid in the address bar
# when you are inside your Content360 workspace.
CONTENT360_WORKSPACE_ID=

# Optional. Leave blank unless Content360 tells you a different API address.
# Default: https://app.content360.io/os/api
CONTENT360_BASE_URL=


# ─────────────────────────────────────────────────────────────────────
# HOUSEKEEPING — you can ignore this section
# ─────────────────────────────────────────────────────────────────────

# Which port the API server listens on. Leave blank for 3001.
PORT=

# Development only. Leave blank. Setting this to 1 lets the server fetch
# images from private/local addresses, which is a security guard we only
# relax for local testing.
ALLOW_PRIVATE_INGEST=
